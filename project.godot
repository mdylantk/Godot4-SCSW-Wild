; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[accessibility]

general/accessibility_support=1

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Strange Cat Strange Wilderness"
run/main_scene="res://Game/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://dj55b1pul12me"

[audio]

general/text_to_speech=true

[autoload]

Game="uid://dvaxx0ke0p27m"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/stretch/mode="viewport"

[editor]

naming/node_name_num_separator=2

[file_customization]

folder_colors={
"res://Common/Features/Tools/": "gray",
"res://Game/": "green",
"res://Game/Maps/": "blue",
"res://Game/Resources/": "teal",
"res://Game/Scenes/": "teal",
"res://Game/Scenes/Actors/": "blue"
}

[global_group]

Players="All loaded player handlers"
Player_Pawns=""
enemies="A test group for enemies"
Savable="Nodes with the autosave function in this group will be called just before the autosave saves"
GUI="For any node that needs to listen to the GUI events"

