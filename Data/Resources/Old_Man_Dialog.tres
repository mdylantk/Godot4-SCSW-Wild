[sub_resource type="Resource" id="Resource_abbk4"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "Hello there little one. I have an inkling that you are not a typical cat. This place is not as it seems. It is like a dream, but not a dream. A place where time and space dose not make any sence. It quite lonely here. Some people come ang go. Other stay for a bit, but end up leaving. I might enjoy this place better if there was more variation of fish to keep me company. Here there is only gray and brown common carp most likely due to my failing imagination or other such factors. This place is odd. Things from all over history appears around here. Maybe even things that never existed. The issue is I am too old to go adventuring and this forest always expaning making locating anything difficult. If you decide to go exploring these parts, then maybe you could do an old man a favor and keep an eye out for any kind of fish. You do not need to bring it back. As long as you find your way back here I am sure those fishes will start appearing."
end_action = SubResource("Resource_dpx4o")

[sub_resource type="Resource" id="Resource_djo12"]
script = ExtResource("1_b76ab")
group_name = "intro"
is_random = false
segments = Array[ExtResource("2_n5o5f")]([SubResource("Resource_abbk4")])

[sub_resource type="Resource" id="Resource_n0b26"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "There is no need to rush to explore. Plenty of time here to get lost."

[sub_resource type="Resource" id="Resource_ul4ex"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "I wish my imagination was as good as it once was. Then maybe a new fish would come and surprise me."

[sub_resource type="Resource" id="Resource_m7tlw"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "Hello there, nice day for fishing."

[sub_resource type="Resource" id="Resource_j67tw"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "Sometimes I worry the forest eat people or maybe that a better though than people just leaving me."

[sub_resource type="Resource" id="Resource_xsoke"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "I remember a fish called a catfish, but I just can not recall what it look like."

[sub_resource type="Resource" id="Resource_6t5uu"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "This place would be a lot worst if there was monster, raiders, or worst...teenagers."

[sub_resource type="Resource" id="Resource_gbwlc"]
script = ExtResource("2_n5o5f")
speaker_name = ""
text = "I do miss the sea..or almost. I am not a fan of the humidity."

[sub_resource type="Resource" id="Resource_rrbab"]
script = ExtResource("1_b76ab")
group_name = "default"
